<Window x:Class="TeachMeOnce.WpfFixture.DelayedDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fixture dialog"
        Width="280"
        Height="150"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="DelayedDialogWindow">
  <StackPanel Margin="20">
    <TextBlock Text="Delayed dialog appeared."
               AutomationProperties.AutomationId="DialogMessage" />
    <Button Width="80"
            HorizontalAlignment="Right"
            Margin="0,18,0,0"
            Content="OK"
            AutomationProperties.AutomationId="DialogOkButton"
            Click="OkButton_OnClick" />
  </StackPanel>
</Window>
